{
  "name": "dsh-direct-chat",
  "version": "0.1.0",
  "description": "Direct CLI chat for DeepSeek Harness (Claude Code, Codex, AGY) with multi-account isolation, workspace tools, and mobile UI.",
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./ui/client.js",
    "./registry": "./registry.mjs",
    "./engines/*": "./engines/*.mjs",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build:ui": "node ui/build.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-jobs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-terminal": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-experimental-client-ui-forge": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.5",
    "@tanstack/react-virtual": "3.14.9",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "@deepseek-ai/dsh-http-proxy": {
      "undici": "8.12.2"
    }
  }
}
